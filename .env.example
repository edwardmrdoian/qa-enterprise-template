# Copy to .env (git-ignored) and export in your shell or IDE run configuration.
# Env var name = config key upper-cased with dots replaced by underscores.
API_KEY=
ENV=qa
BASE_URL=https://the-internet.herokuapp.com
API_BASE_URL=https://reqres.in
BROWSER=chromium
HEADLESS=true
TIMEOUT_SECONDS=15
API_CONNECT_TIMEOUT_MS=10000
API_READ_TIMEOUT_MS=30000
DB_URL=jdbc:h2:mem:qatestdb;DB_CLOSE_DELAY=-1;MODE=PostgreSQL
DB_USERNAME=sa
DB_PASSWORD=
RABBIT_PASSWORD=
ELASTIC_PASSWORD=
